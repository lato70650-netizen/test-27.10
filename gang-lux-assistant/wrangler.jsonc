{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gang-lux-assistant",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "triggers": { "crons": ["*/30 * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "APP_MODE": "production",
    "OPENROUTER_MODEL": "google/gemma-4-26b-a4b-it:free",
    "NOTION_QUESTION_PROPERTY": "Вопрос",
    "NOTION_STATUS_TYPE": "status"
  },
  "keep_vars": true
}
